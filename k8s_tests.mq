def test_k8s_stringify_statefulset_roundtrip_resources():
  let manifest = k8s_parse(statefulset_yaml)
  | let reparsed = k8s_parse(k8s_stringify(manifest))
  | let res = k8s_resources(first(k8s_containers(reparsed)))
  | assert_eq(res["requests"]["cpu"], "200m")
  | assert_eq(res["limits"]["memory"], "512Mi")
end
